{
  "Auth": {
    "ApiKey": "CHANGEME"
  },
  "Kuali": {
    "BaseUrl": "https://csub.kualibuild.com",
    "ApiToken": "CHANGEME",
    "PublicBaseUrl": "",
    "CallbackSecret": "CHANGEME",
    "ExportTimeZone": "America/Los_Angeles",
    "ExportCallbackTimeoutSeconds": 180,
    "ExportCallbackPollMilliseconds": 500
  },
  "Backup": {
    "RootPath": "./backup",
    "RetentionDays": 30,
    "CleanupIntervalHours": 24
  },
  "Retry": {
    "MaxAttempts": 5,
    "BaseDelaySeconds": 60,
    "PollIntervalSeconds": 30,
    "SucceededJobRetentionDays": 30
  },
  "Database": {
    "Path": "./data/kuali-onbase.db"
  },
  "Ui": {
    "Enabled": true
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 25,
      "SmtpUsername": "",
      "SmtpPassword": "",
      "UseSsl": false,
      "From": "",
      "To": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/kuali-onbase-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
